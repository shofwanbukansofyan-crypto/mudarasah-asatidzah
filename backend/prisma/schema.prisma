datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String
  role      String   // 'admin' | 'guru' | 'asatidz'
  createdAt DateTime @default(now())
}