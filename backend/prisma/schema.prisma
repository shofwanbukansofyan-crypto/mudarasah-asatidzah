generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(uuid())
  username    String
  email       String           @unique
  password    String
  role        String           @default("asatidz")
  createdAt   DateTime         @default(now())
  absensi     Absensi[]
  halaqah     Halaqah[]
  submissions SoalSubmission[]
}

model Halaqah {
  id          String           @id @default(uuid())
  nama        String
  deskripsi   String?
  guruId      String
  createdAt   DateTime         @default(now())
  memberIds   String?
  absensi     Absensi[]
  guru        User             @relation(fields: [guruId], references: [id], onDelete: Cascade)
  jadwal      Jadwal[]
  kitab       Kitab[]
  soal        Soal[]
  submissions SoalSubmission[]
}

model Kitab {
  id         String   @id @default(uuid())
  judul      String
  penulis    String?
  fileUrl    String?
  halaqahId  String
  uploadedAt DateTime @default(now())
  coverColor String?
  deskripsi  String?
  guruId     String
  halaqah    Halaqah  @relation(fields: [halaqahId], references: [id], onDelete: Cascade)
}

model Jadwal {
  id         String    @id @default(uuid())
  hari       String
  jam        String
  materi     String
  halaqahId  String
  createdAt  DateTime  @default(now())
  jamSelesai String?
  lokasi     String?
  guruId     String
  absensi    Absensi[]
  halaqah    Halaqah   @relation(fields: [halaqahId], references: [id], onDelete: Cascade)
}

model Absensi {
  id         String   @id @default(uuid())
  jadwalId   String
  userId     String
  status     String
  tanggal    String?
  catatan    String?
  createdAt  DateTime @default(now())
  keterangan String?
  timestamp  String?
  guruId     String?
  halaqahId  String?
  halaqah    Halaqah? @relation(fields: [halaqahId], references: [id], onDelete: Cascade)
  jadwal     Jadwal   @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Soal {
  id          String           @id @default(uuid())
  judul       String
  pertanyaan  String
  halaqahId   String
  createdAt   DateTime         @default(now())
  deadline    String?
  deskripsi   String?
  jadwalId    String?
  halaqah     Halaqah          @relation(fields: [halaqahId], references: [id], onDelete: Cascade)
  submissions SoalSubmission[]
}

model SoalSubmission {
  id          String   @id @default(uuid())
  soalId      String
  userId      String
  jawaban     String
  nilai       Int?
  submittedAt DateTime @default(now())
  guruId      String?
  halaqahId   String?
  halaqah     Halaqah? @relation(fields: [halaqahId], references: [id], onDelete: Cascade)
  soal        Soal     @relation(fields: [soalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
